<%- include("partials/header") %><div class="heading"><div><p class="tag">ADMINISTRATION</p><h1>User accounts</h1></div><a class="btn primary" href="/users/new">＋ Create staff account</a></div><section class="card"><div class="tablewrap"><table><tr><th>Name</th><th>Email</th><th>Role</th><th>Status</th><th>Action</th></tr><% users.forEach(u=>{ %><tr><td><%= u.name %></td><td><%= u.email %></td><td><%= u.role %></td><td><%= u.active?"Active":"Inactive" %></td><td><form method="post" action="/users/<%= u._id %>/toggle"><button><%= u.active?"Deactivate":"Activate" %></button></form></td></tr><% }) %></table></div></section><%- include("partials/footer") %>