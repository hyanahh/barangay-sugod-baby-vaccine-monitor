<%- include("partials/header") %><div class="heading"><div><p class="tag">PRIVATE IN-APP CHAT</p><h1>Messages</h1><p class="muted">Communicate with the linked health center team. Do not send emergencies through chat.</p></div></div><% if(smsNotice){ %><div class="alert"><%= smsNotice %></div><% } %><section class="card"><div class="chatlog"><% messages.forEach(m=>{ %><article class="bubble <%= m.sender._id.toString()===user.id?"mine":"" %>"><small><%= m.sender.name %> · <%= m.createdAt.toLocaleString() %></small><p><%= m.body %></p></article><% }) %><% if(!messages.length){ %><p class="empty">No messages yet.</p><% } %></div><form method="post" action="/messages" class="stack"><label>Send to<select name="recipient" required><option value="">Choose recipient</option><% users.forEach(u=>{ %><option value="<%= u._id %>"><%= u.name %> — <%= u.role %></option><% }) %></select></label><label>Message<textarea name="body" maxlength="2000" required placeholder="Write your message..."></textarea></label><button class="primary">Send message</button></form></section><%- include("partials/footer") %>