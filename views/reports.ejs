<%- include("partials/header") %>
<div class="heading"><div><p class="tag">BARANGAY SUGOD · MONTHLY REPORT</p><h1>Monthly vaccine monitoring report</h1><p class="muted">A summary of vaccination activity for the selected month.</p></div></div>
<section class="card month-toolbar"><form method="get" action="/reports" class="month-filter"><label for="month">Select month</label><input id="month" name="month" type="month" value="<%= month.value %>"><button class="primary">Generate report</button></form><p class="muted">Report period: <strong><%= month.label %></strong></p></section>
<div class="stats"><div class="stat"><span>Total records</span><b><%= summary.total %></b></div><div class="stat"><span>Completed</span><b><%= summary.completed %></b></div><div class="stat"><span>Scheduled</span><b><%= summary.scheduled %></b></div><div class="stat"><span>Missed</span><b><%= summary.missed %></b></div></div>
<section class="card"><div class="sectionhead"><h2>Records for <%= month.label %></h2><button type="button" class="btn" onclick="window.print()">Print monthly report</button></div><% if(!vaccines.length){ %><p class="empty">No vaccination records found for this month.</p><% } else { %><div class="tablewrap"><table><tr><th>Baby</th><th>Vaccine</th><th>Dose</th><th>Date given</th><th>Next due</th><th>Status</th></tr><% vaccines.forEach(v=>{ %><tr><td><%= v.baby?v.baby.fullName:"—" %></td><td><%= v.vaccineName %></td><td><%= v.dose||"—" %></td><td><%= v.dateGiven?v.dateGiven.toLocaleDateString():"—" %></td><td><%= v.nextDueDate?v.nextDueDate.toLocaleDateString():"—" %></td><td><%= v.status %></td></tr><% }) %></table></div><% } %></section>
<%- include("partials/footer") %>