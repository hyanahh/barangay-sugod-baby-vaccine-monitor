<%- include("partials/header") %><div class="heading"><div><p class="tag">BABY RECORD</p><h1><%= baby.fullName %></h1><p class="muted">Born <%= baby.birthDate.toLocaleDateString() %> · Guardian: <%= baby.guardianName %></p></div><a class="btn primary" href="/babies">Back to records</a></div><% if(notice){ %><div class="alert"><%= notice %></div><% } %><section class="card"><h2>Guardian details</h2><p><%= baby.contactNumber||"No phone" %> · <%= baby.guardianEmail||"No email" %> · <%= baby.barangay||"No barangay" %></p></section><section class="card"><div class="sectionhead"><h2>Vaccination history</h2></div><form method="post" action="/babies/<%= baby._id %>/vaccines" class="formgrid"><label>Vaccine name *<input name="vaccineName" required></label><label>Dose<input name="dose"></label><label>Date given<input name="dateGiven" type="date"></label><label>Next due date<input name="nextDueDate" type="date"></label><label>Status<select name="status"><option>Scheduled</option><option>Completed</option><option>Missed</option></select></label><label>Administered by<input name="administeredBy"></label><label class="wide">Notes<textarea name="notes"></textarea></label><div class="wide"><button class="primary">Add vaccine record</button></div></form><hr><div class="tablewrap"><table><tr><th>Vaccine</th><th>Dose</th><th>Date given</th><th>Next due</th><th>Status</th></tr><% vaccines.forEach(v=>{ %><tr><td><%= v.vaccineName %></td><td><%= v.dose||"—" %></td><td><%= v.dateGiven?v.dateGiven.toLocaleDateString():"—" %></td><td><%= v.nextDueDate?v.nextDueDate.toLocaleDateString():"—" %></td><td><%= v.status %></td></tr><% }) %></table></div></section><%- include("partials/footer") %>