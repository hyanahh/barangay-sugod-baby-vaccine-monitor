<%- include("partials/header") %>
<div class="heading"><div><p class="tag">BARANGAY SUGOD · ADMINISTRATOR PORTAL</p><h1>Administrator dashboard</h1><p class="muted">Welcome, <%= user.name %> · System Administrator</p></div><div class="heading-actions"><a class="btn" href="/users">Manage users</a><a class="btn primary" href="/babies/new">＋ Register baby</a></div></div>
<section class="card month-toolbar"><form method="get" action="/dashboard" class="month-filter"><label for="month">Monitoring month</label><input id="month" name="month" type="month" value="<%= month.value %>"><button class="primary">View month</button></form><p class="muted">Showing vaccination activity for <strong><%= month.label %></strong>.</p></section>
<div class="stats"><div class="stat"><span>Registered babies</span><b><%= stats.babyCount %></b></div><div class="stat"><span>Vaccine records this month</span><b><%= stats.total %></b></div><div class="stat"><span>Completed this month</span><b><%= stats.completed %></b></div><div class="stat"><span>Scheduled this month</span><b><%= stats.scheduled %></b></div><div class="stat"><span>Missed this month</span><b><%= stats.missed %></b></div></div>
<section class="card"><div class="sectionhead"><div><h2>Vaccination activity</h2><p class="muted">Records with a date given or next due date in <%= month.label %>.</p></div><a href="/reports?month=<%= month.value %>">Open monthly report →</a></div>
<% if(!vaccines.length){ %><p class="empty">No vaccination activity recorded for this month.</p><% } else { %><div class="tablewrap"><table><tr><th>Baby</th><th>Vaccine</th><th>Dose</th><th>Date given</th><th>Next due</th><th>Status</th></tr><% vaccines.forEach(v=>{ if(v.baby){ %><tr><td><a href="/babies/<%= v.baby._id %>"><%= v.baby.fullName %></a></td><td><%= v.vaccineName %></td><td><%= v.dose||"—" %></td><td><%= v.dateGiven?v.dateGiven.toLocaleDateString():"—" %></td><td><%= v.nextDueDate?v.nextDueDate.toLocaleDateString():"—" %></td><td><%= v.status %></td></tr><% } }) %></table></div><% } %></section>
<%- include("partials/footer") %>