<%- include("partials/header") %><div class="heading"><div><p class="tag">PARENT / GUARDIAN PORTAL</p><h1>Monthly vaccine records</h1><p class="muted">Your linked baby profiles and vaccination activity for the selected month.</p></div></div><section class="card"><h2>Linked baby profiles</h2><% if(!babies.length){ %><p class="empty">No baby profile is linked yet. Please contact your Barangay Health Worker and provide the email used for your account.</p><% } else { babies.forEach(b=>{ %><p><b><%= b.fullName %></b> · Born <%= b.birthDate.toLocaleDateString() %></p><% }) } %></section><section class="card month-toolbar"><form method="get" action="/my-babies" class="month-filter"><label for="month">Monitoring month</label><input id="month" name="month" type="month" value="<%= month.value %>"><button class="primary">View month</button></form><p class="muted">Showing records for <strong><%= month.label %></strong>.</p></section><section class="card"><h2>Vaccination records</h2><% if(!vaccines.length){ %><p class="empty">No vaccination activity recorded for this month.</p><% } else { %><div class="tablewrap"><table><tr><th>Baby</th><th>Vaccine</th><th>Dose</th><th>Given</th><th>Next due</th><th>Status</th></tr><% vaccines.forEach(v=>{ %><tr><td><%= v.baby?v.baby.fullName:"—" %></td><td><%= v.vaccineName %></td><td><%= v.dose||"—" %></td><td><%= v.dateGiven?v.dateGiven.toLocaleDateString():"—" %></td><td><%= v.nextDueDate?v.nextDueDate.toLocaleDateString():"—" %></td><td><%= v.status %></td></tr><% }) %></table></div><% } %></section><%- include("partials/footer") %>