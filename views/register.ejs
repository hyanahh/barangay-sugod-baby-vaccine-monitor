<%- include("partials/header") %><section class="card auth"><p class="tag">PARENT / GUARDIAN</p><h1>Create an account</h1><p class="muted">Your BHW must link your baby's record to your account.</p><% if(error){ %><div class="alert"><%= error %></div><% } %><form method="post" action="/register" class="stack"><label>Full name<input name="name" required></label><label>Email<input name="email" type="email" required></label><label>Phone number<input name="phone" placeholder="+63..."></label><label>Password (at least 10 characters)<input name="password" type="password" minlength="10" required></label><label class="checkline"><input type="checkbox" name="smsOptIn"> I agree to receive vaccine record and next-due-date SMS notifications. I can change this preference later in Settings.</label><button class="primary">Create parent account</button></form><p class="muted center"><a href="/login">Back to sign in</a></p></section><%- include("partials/footer") %>