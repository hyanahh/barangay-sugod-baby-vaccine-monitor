<%- include("partials/header") %><div class="heading"><div><p class="tag">BABY PROFILE</p><h1>Register baby</h1></div><a class="btn" href="/babies">Back</a></div><section class="card"><% if(error){ %><div class="alert"><%= error %></div><% } %><form method="post" action="/babies" class="formgrid"><label>Baby full name *<input name="fullName" required></label><label>Date of birth *<input type="date" name="birthDate" required></label><label>Sex<select name="sex"><option>Not specified</option><option>Female</option><option>Male</option></select></label><label>Parent/guardian name *<input name="guardianName" required></label><label>Guardian phone<input name="contactNumber"></label><label>Guardian email<input name="guardianEmail" type="email"></label><label>Barangay<input name="barangay"></label><label>Parent account email (to link account)<input name="parentEmail" type="email"></label><label class="wide">Notes<textarea name="notes" maxlength="500"></textarea></label><div class="wide"><button class="primary">Save baby</button></div></form></section><%- include("partials/footer") %>