<%- include("partials/header") %><section class="card narrow"><h1>Create staff account</h1><% if(error){ %><div class="alert"><%= error %></div><% } %><form method="post" action="/users" class="stack"><label>Full name<input name="name" required></label><label>Email<input name="email" type="email" required></label><label>Phone<input name="phone"></label><label>Temporary password (10+ characters)<input name="password" type="password" minlength="10" required></label><label>Role<select name="role"><option>Healthcare Worker</option><option>Administrator</option></select></label><button class="primary">Create account</button></form></section><%- include("partials/footer") %>