<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
  <meta name="theme-color" content="#0f766e">
  <title><%= title %> | Barangay Sugod Baby Vaccine Monitoring System</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Manrope:wght@500;600;700;800&display=swap" rel="stylesheet">
  <link rel="icon" type="image/png" href="/images/favicon.png">
  <link rel="stylesheet" href="/style.css">
</head>
<body class="app-page">
<header class="app-header">
  <a class="brand" href="/" aria-label="Barangay Sugod Baby Vaccine Monitoring System home"><img class="brand-mark brand-logo" src="/images/bhw-care-mark.png" alt="" width="42" height="42"><span><strong>Barangay Sugod</strong><small> BABY VACCINE MONITORING SYSTEM</small></span></a>
  <% if(user){ %>
  <button class="menu-toggle app-menu-toggle" type="button" aria-label="Open navigation" aria-expanded="false" aria-controls="app-navigation">☰</button>
  <nav class="app-nav" id="app-navigation" aria-label="Main navigation">
    <% if(user.role === "Parent/Guardian"){ %>
      <a href="/my-babies">My baby's vaccines</a>
    <% } else { %>
      <a href="<%= user.role === 'Administrator' ? '/admin/dashboard' : '/healthcare/dashboard' %>">Dashboard</a><a href="/babies">Baby records</a><a href="/reports">Monthly report</a>
    <% } %>
    <a href="/messages">Messages</a><a href="/settings">Settings</a>
    <% if(user.role === "Administrator"){ %><a href="/users">User accounts</a><% } %>
    <form action="/logout" method="post"><button class="nav-logout" type="submit">Log out</button></form>
  </nav>
  <% } else { %>
    <nav class="app-nav"><a href="/login">Choose portal</a><a href="/parent/login">Parent sign in</a><a href="/register">Parent registration</a></nav>
  <% } %>
</header>
<main class="app-main">
